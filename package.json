  "description": "Virtual Engineer — AI troubleshooting demo with MongoDB Atlas",
  "scripts": {
    "seed": "node scripts/data/seed/load-sample-data.js",
    "seed:drop": "node scripts/data/seed/load-sample-data.js --drop",
