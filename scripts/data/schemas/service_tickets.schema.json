{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service_tickets.schema.json",
  "title": "service_tickets",
  "type": "object",
  "required": [
    "ticket_id",
    "chiller_id",
    "site_id",
    "status",
    "priority",
    "type",
    "opened_at",
    "reported_symptom",
    "related_alarm_codes",
    "technician"
  ],
  "properties": {
    "ticket_id": { "type": "string" },
    "chiller_id": { "type": "string" },
    "site_id": { "type": "string" },
    "status": { "type": "string", "enum": ["open", "in_progress", "closed"] },
    "priority": { "type": "string", "enum": ["P1", "P2", "P3", "P4"] },
    "type": { "type": "string", "enum": ["corrective", "preventive", "emergency"] },
    "opened_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": ["string", "null"], "format": "date-time" },
    "reported_symptom": { "type": "string" },
    "related_alarm_codes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "technician": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "work_performed": { "type": "string" },
    "parts_replaced": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["part_number", "description", "quantity"],
        "properties": {
          "part_number": { "type": "string" },
          "description": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "resolution": { "type": "string" },
    "root_cause": { "type": "string" },
    "searchable_narrative": {
      "type": "string",
      "description": "Derived at seed time from symptom, work_performed, resolution, and root_cause for Atlas autoEmbed search"
    }
  },
  "additionalProperties": false
}
