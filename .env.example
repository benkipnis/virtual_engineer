# Copy to .env and fill in your Atlas values (never commit .env)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=virtual_engineer

# MCP HTTP server
MCP_PORT=3100
MCP_HOST=0.0.0.0
MCP_API_KEY=change-me-in-production
MCP_AUTH_DISABLED=true

# Atlas search index names (create in Atlas UI — see docs/indexes.md)
KNOWLEDGE_VECTOR_INDEX=knowledge_auto_embed_index
TICKETS_VECTOR_INDEX=service_tickets_auto_embed_index
TICKETS_SEARCH_INDEX=service_tickets_search

# LLM agent (required for demo UI chat)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Alternative: LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
AGENT_MAX_STEPS=12
MCP_BASE_URL=http://localhost:3100
CORS_ORIGIN=http://localhost:5173
